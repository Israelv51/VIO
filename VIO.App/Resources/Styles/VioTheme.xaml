<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="VioBlue">#0A84FF</Color>
    <Color x:Key="VioBlueSoft">#EAF4FF</Color>

    <Color x:Key="VioBackground">#F5F5F7</Color>
    <Color x:Key="VioSurface">#FFFFFF</Color>

    <Color x:Key="VioTextPrimary">#1D1D1F</Color>
    <Color x:Key="VioTextSecondary">#6E6E73</Color>
    <Color x:Key="VioTextTertiary">#8E8E93</Color>

    <Color x:Key="VioBorder">#E5E5EA</Color>

    <Color x:Key="VioSuccess">#34C759</Color>
    <Color x:Key="VioWarning">#FF9F0A</Color>
    <Color x:Key="VioError">#FF3B30</Color>

    <Style
        x:Key="VioLargeTitle"
        TargetType="Label">

        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource VioTextPrimary}" />

    </Style>

    <Style
        x:Key="VioSectionTitle"
        TargetType="Label">

        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource VioTextPrimary}" />

    </Style>

    <Style
        x:Key="VioBody"
        TargetType="Label">

        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor"
                Value="{StaticResource VioTextSecondary}" />

    </Style>

    <Style
        x:Key="VioPrimaryButton"
        TargetType="Button">

        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource VioBlue}" />

        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />

    </Style>

</ResourceDictionary>
