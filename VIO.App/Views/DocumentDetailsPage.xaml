<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.DocumentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    x:DataType="viewModels:DocumentDetailsViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Padding="20,14"
            ColumnDefinitions="Auto,*"
            BackgroundColor="White">

            <Button
                Text="‹"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                FontSize="30"
                Padding="0"
                BackgroundColor="#F2F2F7"
                TextColor="#1D1D1F"
                Clicked="OnBackClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="14,0"
                VerticalOptions="Center">

                <Label
                    Text="Documento"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#1D1D1F" />

                <Label
                    Text="{Binding FileInfo}"
                    FontSize="11"
                    TextColor="#8E8E93" />

            </VerticalStackLayout>

        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24"
                Spacing="16">

                <Border
                    Padding="22"
                    BackgroundColor="White"
                    Stroke="#E5E5EA"
                    StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Información"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1D1D1F" />

                        <Entry
                            Text="{Binding DisplayName}"
                            Placeholder="Nombre del documento" />

                        <Picker
                            Title="Categoría"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding Category}" />

                        <Editor
                            Text="{Binding Description}"
                            Placeholder="Descripción o notas"
                            HeightRequest="100" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Padding="22"
                    BackgroundColor="White"
                    Stroke="#E5E5EA"
                    StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Privacidad"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1D1D1F" />

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>

                                <Label
                                    Text="Documento privado"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#1D1D1F" />

                                <Label
                                    Text="No aparecerá en un perfil público."
                                    FontSize="12"
                                    TextColor="#6E6E73" />

                            </VerticalStackLayout>

                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding IsPrivate}"
                                OnColor="#0A84FF" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E5E5EA" />

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>

                                <Label
                                    Text="Documento oficial"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#1D1D1F" />

                                <Label
                                    Text="CURP, INE, RFC, actas o documentos similares."
                                    FontSize="12"
                                    TextColor="#6E6E73" />

                            </VerticalStackLayout>

                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding IsOfficialDocument}"
                                OnColor="#0A84FF" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <Label
                    Text="{Binding Message}"
                    FontSize="12"
                    TextColor="#34C759"
                    HorizontalTextAlignment="Center" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">

                    <Button
                        Text="Abrir"
                        HeightRequest="50"
                        CornerRadius="15"
                        BackgroundColor="#EAF4FF"
                        TextColor="#0A84FF"
                        Command="{Binding OpenCommand}" />

                    <Button
                        Grid.Column="1"
                        Text="Compartir"
                        HeightRequest="50"
                        CornerRadius="15"
                        BackgroundColor="#EAF4FF"
                        TextColor="#0A84FF"
                        Command="{Binding ShareCommand}" />

                </Grid>

                <Button
                    Text="Eliminar documento"
                    HeightRequest="48"
                    CornerRadius="15"
                    BackgroundColor="#FFF0F0"
                    TextColor="#FF3B30"
                    Command="{Binding DeleteCommand}" />

            </VerticalStackLayout>

        </ScrollView>

        <Border
            Grid.Row="2"
            Padding="20,12,20,20"
            BackgroundColor="White"
            StrokeThickness="0">

            <Button
                Text="Guardar cambios"
                HeightRequest="56"
                CornerRadius="17"
                BackgroundColor="#0A84FF"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}" />

        </Border>

    </Grid>

</ContentPage>
