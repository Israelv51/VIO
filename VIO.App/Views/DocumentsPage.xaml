<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.DocumentsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    xmlns:models="clr-namespace:VIO.App.Models"
    x:DataType="viewModels:DocumentsViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource VioBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,120"
            Spacing="16">

            <Label
                Text="Documentos"
                Style="{StaticResource VioLargeTitle}" />

            <Label
                Text="Tu expediente profesional, siempre organizado."
                Style="{StaticResource VioBody}" />

            <!-- EXPEDIENTE -->
            <Border
                Margin="0,10,0,0"
                Padding="22"
                BackgroundColor="#0A84FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout>

                            <Label
                                Text="Expediente laboral"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="{Binding EmploymentSuggestionText}"
                                FontSize="12"
                                TextColor="#EAF4FF" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="{Binding EmploymentProgressText}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center" />

                    </Grid>

                    <ProgressBar
                        Progress="{Binding EmploymentProgress}"
                        ProgressColor="White"
                        HeightRequest="7" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Recomendados para trabajar"
                Margin="0,8,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Label
                Text="VIO detecta lo que ya tienes y te ayuda a completar tu expediente."
                FontSize="12"
                TextColor="{StaticResource VioTextSecondary}" />

            <CollectionView
                ItemsSource="{Binding BaseSuggestions}"
                HeightRequest="185"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Horizontal"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:DocumentSuggestion">

                        <Border
                            WidthRequest="220"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="{StaticResource VioBorder}"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="7">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Border
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{StaticResource VioBlueSoft}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">

                                        <Label
                                            Text="{Binding StatusIcon}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource VioBlue}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding StatusText}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource VioBlue}" />

                                </Grid>

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource VioTextPrimary}" />

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="10"
                                    MaxLines="2"
                                    TextColor="{StaticResource VioTextSecondary}" />

                                <Button
                                    Text="{Binding StatusText}"
                                    HeightRequest="34"
                                    Padding="10,2"
                                    CornerRadius="11"
                                    FontSize="11"
                                    BackgroundColor="{StaticResource VioBlueSoft}"
                                    TextColor="{StaticResource VioBlue}"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SuggestionCommand}"
                                    CommandParameter="{Binding .}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Según el puesto"
                Style="{StaticResource VioSectionTitle}" />

            <CollectionView
                ItemsSource="{Binding OptionalSuggestions}"
                HeightRequest="150"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Horizontal"
                        ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:DocumentSuggestion">

                        <Border
                            WidthRequest="190"
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="{StaticResource VioBorder}"
                            StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource VioTextPrimary}" />

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="10"
                                    MaxLines="2"
                                    TextColor="{StaticResource VioTextSecondary}" />

                                <Button
                                    Text="{Binding StatusText}"
                                    HeightRequest="32"
                                    Padding="8,2"
                                    CornerRadius="10"
                                    FontSize="10"
                                    BackgroundColor="{StaticResource VioBlueSoft}"
                                    TextColor="{StaticResource VioBlue}"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SuggestionCommand}"
                                    CommandParameter="{Binding .}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- CREAR DOCUMENTOS -->
            <Label
                Text="Agregar"
                Margin="0,10,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                <Button
                    Text="Escanear documento"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="{StaticResource VioBlue}"
                    TextColor="White"
                    Command="{Binding OpenScannerCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Doble cara"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="{StaticResource VioBlueSoft}"
                    TextColor="{StaticResource VioBlue}"
                    Command="{Binding OpenTwoSidedScannerCommand}" />

            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                <Button
                    Text="Fotos → PDF"
                    HeightRequest="48"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="{StaticResource VioBlue}"
                    BorderWidth="1"
                    TextColor="{StaticResource VioBlue}"
                    Command="{Binding CreatePdfFromPhotosCommand}" />

                <Button
                    Grid.Column="1"
                    Text="+ Archivo"
                    HeightRequest="48"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="{StaticResource VioBorder}"
                    BorderWidth="1"
                    TextColor="{StaticResource VioTextPrimary}"
                    Command="{Binding AddNamedDocumentCommand}" />

            </Grid>

            <!-- BIBLIOTECA -->
            <Label
                Text="Mis documentos"
                Margin="0,12,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Border
                Padding="12,0"
                HeightRequest="50"
                BackgroundColor="#E9E9ED"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15">

                <SearchBar
                    Text="{Binding SearchText}"
                    Placeholder="Buscar en mi expediente"
                    BackgroundColor="Transparent" />

            </Border>

            <Label
                Text="{Binding Message}"
                FontSize="12"
                TextColor="{StaticResource VioBlue}" />

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource VioBlue}" />

            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None"
                HeightRequest="650">

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:VioDocument">

                        <Border
                            Margin="0,5"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="{StaticResource VioBorder}"
                            StrokeShape="RoundRectangle 20">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="14">

                                <Border
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="{StaticResource VioBlueSoft}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">

                                    <Label
                                        Text="{Binding TypeLabel}"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource VioBlue}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">

                                    <Label
                                        Text="{Binding DisplayName}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        TextColor="{StaticResource VioTextPrimary}" />

                                    <Label
                                        Text="{Binding Category}"
                                        FontSize="11"
                                        TextColor="{StaticResource VioBlue}" />

                                    <HorizontalStackLayout Spacing="4">

                                        <Label
                                            Text="{Binding PrivacyIcon}"
                                            FontSize="10" />

                                        <Label
                                            Text="{Binding PrivacyText}"
                                            FontSize="10"
                                            TextColor="{StaticResource VioTextSecondary}" />

                                        <Label
                                            Text=" · "
                                            FontSize="10"
                                            TextColor="{StaticResource VioTextSecondary}" />

                                        <Label
                                            Text="{Binding SizeText}"
                                            FontSize="10"
                                            TextColor="{StaticResource VioTextSecondary}" />

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="2"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Button
                                        Text="Vista"
                                        FontSize="10"
                                        Padding="9,4"
                                        CornerRadius="10"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.PreviewCommand}"
                                        CommandParameter="{Binding .}" />

                                    <Button
                                        Text="•••"
                                        FontSize="11"
                                        Padding="9,4"
                                        CornerRadius="10"
                                        BackgroundColor="{StaticResource VioBlueSoft}"
                                        TextColor="{StaticResource VioBlue}"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.DetailsCommand}"
                                        CommandParameter="{Binding .}" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
