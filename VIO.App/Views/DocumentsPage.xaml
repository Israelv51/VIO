<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.DocumentsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    xmlns:models="clr-namespace:VIO.App.Models"
    x:DataType="viewModels:DocumentsViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource VioBackground}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView>

            <VerticalStackLayout
                Padding="24,22,24,110"
                Spacing="14">

                <Label
                    Text="Documentos"
                    Style="{StaticResource VioLargeTitle}" />

                <Label
                    Text="Tus archivos importantes siempre contigo."
                    Style="{StaticResource VioBody}" />

                <Border
                    Margin="0,12,0,4"
                    Padding="14,2"
                    HeightRequest="52"
                    BackgroundColor="#E9E9ED"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">

                    <SearchBar
                        Text="{Binding SearchText}"
                        Placeholder="Buscar documentos"
                        BackgroundColor="Transparent"
                        FontSize="15" />

                </Border>

                <Label
                    Text="{Binding Message}"
                    FontSize="13"
                    TextColor="{StaticResource VioBlue}" />

                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="{StaticResource VioBlue}" />

                <Border
                    IsVisible="False"
                    Padding="26"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="PDF"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />

                        <Label
                            Text="Aún no tienes documentos"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Text="Agrega un PDF o una imagen para comenzar."
                            FontSize="13"
                            TextColor="{StaticResource VioTextSecondary}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <CollectionView
                    ItemsSource="{Binding Items}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:VioDocument">

                            <Border
                                Margin="0,5"
                                Padding="16"
                                BackgroundColor="White"
                                Stroke="{StaticResource VioBorder}"
                                StrokeShape="RoundRectangle 20">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="14">

                                    <Border
                                        Grid.RowSpan="2"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        BackgroundColor="{StaticResource VioBlueSoft}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14">

                                        <Label
                                            Text="{Binding TypeLabel}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource VioBlue}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="{Binding DisplayName}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{StaticResource VioTextPrimary}" />

                                        <Label
                                            FontSize="12"
                                            TextColor="{StaticResource VioTextSecondary}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding SizeText}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding DateText}" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>

                                    </VerticalStackLayout>

                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Grid.RowSpan="2"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Button
                                            Text="Abrir"
                                            FontSize="11"
                                            Padding="10,5"
                                            CornerRadius="10"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenDocumentCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="↑"
                                            FontSize="15"
                                            Padding="9,5"
                                            CornerRadius="10"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShareDocumentCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="×"
                                            FontSize="16"
                                            Padding="9,5"
                                            CornerRadius="10"
                                            BackgroundColor="#FFE5E5"
                                            TextColor="{StaticResource VioError}"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteDocumentCommand}"
                                            CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <VerticalStackLayout
            Grid.Row="1"
            Margin="24,8,24,18"
            Spacing="8">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                <Button
                    Text="Escanear documento"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="{StaticResource VioBlue}"
                    TextColor="White"
                    Command="{Binding OpenScannerCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Doble cara"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="{StaticResource VioBlueSoft}"
                    TextColor="{StaticResource VioBlue}"
                    Command="{Binding OpenTwoSidedScannerCommand}" />

            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">

                <Button
                    Text="Fotos → PDF"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="{StaticResource VioBlue}"
                    BorderWidth="1"
                    TextColor="{StaticResource VioBlue}"
                    Command="{Binding CreatePdfFromPhotosCommand}" />

                <Button
                    Grid.Column="1"
                    Text="+ Archivo"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="{StaticResource VioBorder}"
                    BorderWidth="1"
                    TextColor="{StaticResource VioTextPrimary}"
                    Command="{Binding AddDocumentCommand}" />

            </Grid>

        </VerticalStackLayout>

    </Grid>

</ContentPage>




