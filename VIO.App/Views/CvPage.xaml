<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.CvPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    x:DataType="viewModels:CvViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource VioBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,120"
            Spacing="14">

            <Label
                Text="Mi CV"
                Style="{StaticResource VioLargeTitle}" />

            <Label
                Text="Tu identidad profesional, construida desde VIO."
                Style="{StaticResource VioBody}" />

            <!-- Progreso -->
            <Border
                Margin="0,12,0,0"
                Padding="20"
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Perfil profesional"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding CompletionText}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />

                    </Grid>

                    <ProgressBar
                        Progress="{Binding CompletionProgress}"
                        ProgressColor="{StaticResource VioBlue}"
                        HeightRequest="7" />

                    <Label
                        Text="Completa tus datos para generar un CV más completo."
                        FontSize="12"
                        TextColor="{StaticResource VioTextSecondary}" />

                </VerticalStackLayout>

            </Border>

            <!-- Perfil -->
            <Border
                Padding="20"
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 22">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">

                    <Border
                        WidthRequest="62"
                        HeightRequest="62"
                        BackgroundColor="{StaticResource VioBlueSoft}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 31">

                        <Label
                            Text="CV"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="4">

                        <Label
                            Text="{Binding ProfessionalTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Text="{Binding Summary}"
                            FontSize="13"
                            MaxLines="2"
                            LineBreakMode="TailTruncation"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        VerticalOptions="Center"
                        TextColor="{StaticResource VioTextTertiary}" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding EditProfileCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

            <!-- Estadísticas -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <Border
                    Padding="13"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label
                            Text="{Binding EducationCount}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />
                        <Label
                            Text="Estudios"
                            FontSize="11"
                            TextColor="{StaticResource VioTextSecondary}" />
                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="1"
                    Padding="13"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label
                            Text="{Binding ExperienceCount}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />
                        <Label
                            Text="Experiencias"
                            FontSize="11"
                            TextColor="{StaticResource VioTextSecondary}" />
                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Row="1"
                    Padding="13"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label
                            Text="{Binding SkillCount}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />
                        <Label
                            Text="Habilidades"
                            FontSize="11"
                            TextColor="{StaticResource VioTextSecondary}" />
                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="13"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label
                            Text="{Binding CertificationCount}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />
                        <Label
                            Text="Certificaciones"
                            FontSize="11"
                            TextColor="{StaticResource VioTextSecondary}" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- Generador -->
            <Label
                Text="Curriculum Vitae"
                Margin="0,12,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Border
                Padding="20"
                BackgroundColor="#0A84FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Genera tu CV"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="VIO utilizará automáticamente tu perfil, estudios, experiencia, habilidades y certificaciones."
                        FontSize="13"
                        TextColor="#EAF4FF" />

                    <ActivityIndicator
                        IsVisible="{Binding IsGenerating}"
                        IsRunning="{Binding IsGenerating}"
                        Color="White" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <Button
                            Text="Generar PDF"
                            HeightRequest="50"
                            CornerRadius="15"
                            BackgroundColor="White"
                            TextColor="{StaticResource VioBlue}"
                            Command="{Binding GeneratePdfCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="Generar y compartir"
                            HeightRequest="50"
                            CornerRadius="15"
                            BackgroundColor="#267FFF"
                            BorderColor="#66FFFFFF"
                            BorderWidth="1"
                            TextColor="White"
                            Command="{Binding GenerateAndSharePdfCommand}" />

                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <Button
                            Text="Abrir último CV"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="#22FFFFFF"
                            TextColor="White"
                            Command="{Binding OpenLastCvCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="Ver en VIO"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="White"
                            TextColor="{StaticResource VioBlue}"
                            Command="{Binding PreviewCommand}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="{Binding Message}"
                FontSize="13"
                TextColor="{StaticResource VioBlue}" />

            <!-- Información -->
            <Label
                Text="Información"
                Margin="0,12,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Border
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout>

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Perfil profesional"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="27"
                            TextColor="{StaticResource VioTextTertiary}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EditProfileCommand}" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <BoxView
                        Margin="18,0"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource VioBorder}" />

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Formación académica"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="27"
                            TextColor="{StaticResource VioTextTertiary}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EducationCommand}" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <BoxView
                        Margin="18,0"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource VioBorder}" />

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Experiencia"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="27"
                            TextColor="{StaticResource VioTextTertiary}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ExperienceCommand}" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <BoxView
                        Margin="18,0"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource VioBorder}" />

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Habilidades"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="27"
                            TextColor="{StaticResource VioTextTertiary}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SkillsCommand}" />
                        </Grid.GestureRecognizers>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

