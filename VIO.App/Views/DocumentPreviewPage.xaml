<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.DocumentPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    x:DataType="viewModels:DocumentPreviewViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Padding="20,14"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="White">

            <Button
                Text="‹"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                FontSize="30"
                Padding="0"
                BackgroundColor="#F2F2F7"
                TextColor="#1D1D1F"
                Clicked="OnBackClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="14,0"
                VerticalOptions="Center">

                <Label
                    Text="{Binding DisplayName}"
                    FontSize="17"
                    FontAttributes="Bold"
                    LineBreakMode="TailTruncation"
                    TextColor="#1D1D1F" />

                <Label
                    Text="{Binding FileInfo}"
                    FontSize="11"
                    TextColor="#8E8E93" />

            </VerticalStackLayout>

            <Border
                Grid.Column="2"
                Padding="11,6"
                BackgroundColor="#EAF4FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">

                <Label
                    Text="{Binding PrivacyText}"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#0A84FF" />

            </Border>

        </Grid>

        <Grid
            Grid.Row="1"
            Padding="20">

            <Border
                Padding="14"
                BackgroundColor="#E7E7EB"
                Stroke="#D1D1D6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26">

                <Grid>

                    <Border
                        Margin="15"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <Image
                            Source="{Binding PreviewPath}"
                            Aspect="AspectFit" />

                    </Border>

                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        WidthRequest="38"
                        HeightRequest="38"
                        Color="#0A84FF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,12,20,20"
            BackgroundColor="White"
            StrokeThickness="0">

            <VerticalStackLayout Spacing="8">

                <Label
                    Text="{Binding Message}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    TextColor="#FF3B30" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">

                    <Button
                        Text="Abrir completo"
                        HeightRequest="52"
                        CornerRadius="16"
                        BackgroundColor="#EAF4FF"
                        TextColor="#0A84FF"
                        Command="{Binding OpenCommand}" />

                    <Button
                        Grid.Column="1"
                        Text="Compartir"
                        HeightRequest="52"
                        CornerRadius="16"
                        BackgroundColor="#0A84FF"
                        TextColor="White"
                        Command="{Binding ShareCommand}" />

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>
