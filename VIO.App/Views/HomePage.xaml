<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource VioBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,110"
            Spacing="16">

            <!-- HEADER -->
            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,4">

                <VerticalStackLayout Spacing="2">

                    <Label
                        Text="{Binding FirstName, StringFormat='Hola, {0}'}"
                        FontSize="31"
                        FontAttributes="Bold"
                        TextColor="{StaticResource VioTextPrimary}" />

                    <Label
                        Text="{Binding ProfessionalTitle}"
                        FontSize="14"
                        TextColor="{StaticResource VioTextSecondary}" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="58"
                    HeightRequest="58"
                    BackgroundColor="{StaticResource VioBlueSoft}"
                    Stroke="#D8E9FF"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20">

                    <Grid>

                        <Label
                            Text="V"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                        <Image
                            Source="{Binding ProfilePhotoPath}"
                            Aspect="AspectFill" />

                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToProfileCommand}" />
                    </Border.GestureRecognizers>

                </Border>

            </Grid>

            <!-- HERO -->
            <Border
                Margin="0,10,0,0"
                Padding="24"
                BackgroundColor="#0A84FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Tu identidad profesional"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="{Binding StatusMessage}"
                            FontSize="13"
                            TextColor="#EAF4FF" />

                        <Grid
                            Margin="0,10,0,0"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <ProgressBar
                                Progress="{Binding CompletionProgress}"
                                ProgressColor="White"
                                HeightRequest="7"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding CompletionText}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </Grid>

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="68"
                        HeightRequest="68"
                        BackgroundColor="#22FFFFFF"
                        Stroke="#33FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22">

                        <Label
                            Text="{Binding CompletionPercentage, StringFormat='{0}%'}"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding GoToCvCommand}" />
                </Border.GestureRecognizers>

            </Border>

            <Label
                Margin="0,10,0,0"
                Text="Tu espacio"
                Style="{StaticResource VioSectionTitle}" />

            <!-- CARDS -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <Border
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="46"
                            HeightRequest="46"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource VioBlueSoft}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">

                            <Label
                                Text="CV"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource VioBlue}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Mi CV"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Text="Genera y comparte tu CV"
                            FontSize="12"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToCvCommand}" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="46"
                            HeightRequest="46"
                            HorizontalOptions="Start"
                            BackgroundColor="#EAF4FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">

                            <Label
                                Text="PDF"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{StaticResource VioBlue}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Documentos"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding DocumentsCount, StringFormat='{0} archivos guardados'}"
                            FontSize="12"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToDocumentsCommand}" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    Grid.Row="1"
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="46"
                            HeightRequest="46"
                            HorizontalOptions="Start"
                            BackgroundColor="#EAF8EE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">

                            <Label
                                Text="✓"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource VioSuccess}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Certificaciones"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding CertificationsCount, StringFormat='{0} registradas'}"
                            FontSize="12"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToCertificationsCommand}" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="{StaticResource VioBorder}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="46"
                            HeightRequest="46"
                            HorizontalOptions="Start"
                            BackgroundColor="#F2EDFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">

                            <Label
                                Text="ID"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#7657E8"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Mi perfil"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding SkillsCount, StringFormat='{0} habilidades'}"
                            FontSize="12"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToProfileCommand}" />
                    </Border.GestureRecognizers>

                </Border>

            </Grid>

            <!-- RESUMEN -->
            <Label
                Margin="0,10,0,0"
                Text="Resumen"
                Style="{StaticResource VioSectionTitle}" />

            <Border
                Padding="20"
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 22">

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">

                    <VerticalStackLayout
                        HorizontalOptions="Center">

                        <Label
                            Text="{Binding ExperienceCount}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />

                        <Label
                            Text="Experiencias"
                            FontSize="10"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center">

                        <Label
                            Text="{Binding SkillsCount}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />

                        <Label
                            Text="Habilidades"
                            FontSize="10"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="2"
                        HorizontalOptions="Center">

                        <Label
                            Text="{Binding CertificationsCount}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource VioBlue}" />

                        <Label
                            Text="Certificados"
                            FontSize="10"
                            TextColor="{StaticResource VioTextSecondary}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <Label
                Margin="0,12"
                Text="VIO · Verified Identity &amp; Opportunities"
                FontSize="10"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource VioTextTertiary}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
