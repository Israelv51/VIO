<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.CvPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    xmlns:models="clr-namespace:VIO.App.Models"
    x:DataType="viewModels:CvPreviewViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Padding="22,16"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="White">

            <Button
                Text="‹"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                FontSize="32"
                BackgroundColor="#F2F2F7"
                TextColor="#1D1D1F"
                Clicked="OnBackClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="14,0"
                VerticalOptions="Center">

                <Label
                    Text="Vista previa del CV"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#1D1D1F" />

                <Label
                    Text="Vista en vivo"
                    FontSize="12"
                    TextColor="#34C759" />

            </VerticalStackLayout>

            <Border
                Grid.Column="2"
                Padding="12,7"
                BackgroundColor="#EAF8EE"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15">

                <Label
                    Text="●  EN VIVO"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#34C759" />

            </Border>

        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="22,20,22,70">

                <!-- CV CARD -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DDE3EE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26">

                    <VerticalStackLayout>

                        <!-- HERO -->
                        <Grid
                            Padding="28"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="22"
                            BackgroundColor="#0A64D8">

                            <Border
                                WidthRequest="110"
                                HeightRequest="110"
                                BackgroundColor="#337BD8"
                                Stroke="#FFFFFF"
                                StrokeThickness="3"
                                StrokeShape="RoundRectangle 24">

                                <Grid>

                                    <Label
                                        Text="{Binding Initials}"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                    <Image
                                        Source="{Binding PhotoPath}"
                                        Aspect="AspectFill" />

                                </Grid>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="29"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="{Binding ProfessionalTitle}"
                                    FontSize="16"
                                    TextColor="#EAF4FF" />

                                <HorizontalStackLayout
                                    Margin="0,8,0,0"
                                    Spacing="8">

                                    <Label
                                        Text="{Binding Email}"
                                        FontSize="12"
                                        TextColor="White" />

                                    <Label
                                        Text="·"
                                        TextColor="#A9D2FF" />

                                    <Label
                                        Text="{Binding Phone}"
                                        FontSize="12"
                                        TextColor="White" />

                                    <Label
                                        Text="·"
                                        TextColor="#A9D2FF" />

                                    <Label
                                        Text="{Binding City}"
                                        FontSize="12"
                                        TextColor="White" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Grid>

                        <!-- CONTENIDO -->
                        <Grid
                            Padding="28"
                            ColumnDefinitions="2*,1*"
                            ColumnSpacing="28">

                            <!-- COLUMNA PRINCIPAL -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="20">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Perfil profesional"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <Label
                                        Text="{Binding Summary}"
                                        FontSize="13"
                                        LineHeight="1.25"
                                        TextColor="#45454A" />

                                </VerticalStackLayout>

                                <!-- EXPERIENCIA -->
                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Experiencia"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding Experiences}"
                                        Spacing="14">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:WorkExperience">

                                                <VerticalStackLayout Spacing="3">

                                                    <Label
                                                        Text="{Binding Position}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#1D1D1F" />

                                                    <Label
                                                        Text="{Binding Company}"
                                                        FontSize="12"
                                                        TextColor="#0A84FF" />

                                                    <Label
                                                        Text="{Binding Description}"
                                                        FontSize="12"
                                                        LineHeight="1.2"
                                                        TextColor="#6E6E73" />

                                                </VerticalStackLayout>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                                <!-- ESTUDIOS -->
                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Formación académica"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding Education}"
                                        Spacing="12">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:Education">

                                                <VerticalStackLayout Spacing="3">

                                                    <Label
                                                        Text="{Binding Degree}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#1D1D1F" />

                                                    <Label
                                                        Text="{Binding Institution}"
                                                        FontSize="12"
                                                        TextColor="#6E6E73" />

                                                </VerticalStackLayout>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                            <!-- SIDEBAR -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="20">

                                <VerticalStackLayout Spacing="6">

                                    <Label
                                        Text="Enlaces"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <Label
                                        Text="GitHub"
                                        FontSize="12"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding GitHub}"
                                        FontSize="11"
                                        TextColor="#0A84FF" />

                                    <Label
                                        Text="LinkedIn"
                                        FontSize="12"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding LinkedIn}"
                                        FontSize="11"
                                        TextColor="#0A84FF" />

                                </VerticalStackLayout>

                                <!-- SKILLS -->
                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Habilidades"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <FlexLayout
                                        Wrap="Wrap"
                                        Direction="Row"
                                        BindableLayout.ItemsSource="{Binding Skills}">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:Skill">

                                                <Border
                                                    Margin="0,0,6,6"
                                                    Padding="10,5"
                                                    BackgroundColor="#EAF4FF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12">

                                                    <Label
                                                        Text="{Binding Name}"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="#0A64D8" />

                                                </Border>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </FlexLayout>

                                </VerticalStackLayout>

                                <!-- CERTIFICACIONES -->
                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Certificaciones"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#17233D" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="#E5E5EA" />

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding Certifications}"
                                        Spacing="10">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:Certification">

                                                <VerticalStackLayout Spacing="2">

                                                    <Label
                                                        Text="{Binding Name}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#1D1D1F" />

                                                    <Label
                                                        Text="{Binding Issuer}"
                                                        FontSize="10"
                                                        TextColor="#6E6E73" />

                                                </VerticalStackLayout>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
