<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VIO.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:VIO.App.ViewModels"
    x:DataType="viewModels:ProfileViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource VioBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,60"
            Spacing="16">

            <Label
                Text="Perfil"
                Style="{StaticResource VioLargeTitle}" />

            <Label
                Text="Tu identidad dentro de VIO."
                Style="{StaticResource VioBody}" />

            <Border
                Margin="0,12,0,0"
                Padding="24"
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 26">

                <VerticalStackLayout
                    Spacing="14"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="132"
                        HeightRequest="132"
                        BackgroundColor="{StaticResource VioBlueSoft}"
                        Stroke="#D8E9FF"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 34">

                        <Grid>

                            <Label
                                Text="VIO"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{StaticResource VioBlue}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <Image
                                Source="{Binding ProfilePhotoPath}"
                                Aspect="AspectFill" />

                        </Grid>

                    </Border>

                    <Label
                        Text="{Binding Name}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{StaticResource VioTextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding Email}"
                        FontSize="13"
                        TextColor="{StaticResource VioTextSecondary}"
                        HorizontalTextAlignment="Center" />

                    <VerticalStackLayout
                        WidthRequest="420"
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <Button
                                Text="Cambiar foto"
                                HeightRequest="48"
                                CornerRadius="15"
                                BackgroundColor="{StaticResource VioBlue}"
                                TextColor="White"
                                Command="{Binding SelectPhotoCommand}" />

                            <Button
                                Grid.Column="1"
                                Text="Ajustar foto"
                                HeightRequest="48"
                                CornerRadius="15"
                                BackgroundColor="{StaticResource VioBlueSoft}"
                                TextColor="{StaticResource VioBlue}"
                                Command="{Binding AdjustPhotoCommand}" />

                        </Grid>

                        <Button
                            Text="Eliminar foto"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="#FFF0F0"
                            TextColor="{StaticResource VioError}"
                            Command="{Binding RemovePhotoCommand}" />

                    </VerticalStackLayout>

                    <Label
                        Text="{Binding PhotoMessage}"
                        FontSize="12"
                        TextColor="{StaticResource VioSuccess}" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Cuenta"
                Margin="0,12,0,0"
                Style="{StaticResource VioSectionTitle}" />

            <Border
                BackgroundColor="White"
                Stroke="{StaticResource VioBorder}"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout>

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Editar perfil"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="26"
                            TextColor="{StaticResource VioTextTertiary}" />

                    </Grid>

                    <BoxView
                        Margin="18,0"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource VioBorder}" />

                    <Grid
                        Padding="18"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Seguridad"
                            FontSize="16"
                            TextColor="{StaticResource VioTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="26"
                            TextColor="{StaticResource VioTextTertiary}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Button
                Margin="0,12,0,0"
                Text="Cerrar sesión"
                HeightRequest="54"
                CornerRadius="16"
                BackgroundColor="#FFE9E9"
                TextColor="{StaticResource VioError}"
                Command="{Binding LogoutCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

